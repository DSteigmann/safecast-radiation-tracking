# Local defaults for producer.py
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=safecast-measurements
SUBMISSION_SPEED=10
MEASUREMENTS_FILE=measurements-out-short.csv

# AWS/MSK example:
# KAFKA_BROKERS=b-1.example.kafka.amazonaws.com:9092,b-2.example.kafka.amazonaws.com:9092
