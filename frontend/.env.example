# Middleware websocket URL.
#
# Local testing (CSV replay, no Kafka needed):
VITE_WS_URL=ws://localhost:8080/testing
#
# Live Kafka stream (needs docker compose + producer running):
#   VITE_WS_URL=ws://localhost:8080/ws
#
# Deployment over HTTPS (use wss:// for a secure websocket):
#   VITE_WS_URL=wss://your-host/ws


# Local testing (needs the python producer to run)
VITE_PRODUCER_API_URL=http://localshost:8042
